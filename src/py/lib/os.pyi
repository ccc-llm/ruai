"""py0: more of the builtin module `os` (CPython's names; `os.environ.get` is
declared as `environ_get`, `os.path.isdir` as `path_isdir`)."""

from rust import Result

def getcwd() -> str: ...

def getpid() -> int: ...

def environ_get(key: str, default: str | None = None) -> str | None: ...

def listdir(path: str = ".") -> Result[list[str], OSError]: ...

def makedirs(name: str, exist_ok: bool = False) -> Result[None, OSError]: ...

def rmdir(path: str) -> Result[None, OSError]: ...

def rename(src: str, dst: str) -> Result[None, OSError]: ...

def path_isdir(s: str) -> bool: ...

def path_isfile(path: str) -> bool: ...

def path_isabs(s: str) -> bool: ...

def path_getsize(filename: str) -> Result[int, OSError]: ...

def path_normpath(path: str) -> str: ...

def path_abspath(path: str) -> str: ...

def path_realpath(filename: str) -> str: ...

def path_expanduser(path: str) -> str: ...

def path_dirname(p: str) -> str: ...

def path_basename(p: str) -> str: ...

def path_splitext(p: str) -> tuple[str, str]: ...

def path_relpath(path: str, start: str = ".") -> str: ...
