# crate: pyrt/plot
"""py0 package `ruai.plot`: plots with matplotlib.pyplot's API, in Rust
(`import ruai.plot as plt`). `show()` opens the figures in the browser, drawn on
a canvas; `savefig` writes .svg or .html. Limits and ticks are matplotlib's.
CPython stand-in: py0/python/ruai/plot.py (matplotlib.pyplot itself)."""

from numpy import ndarray
from rust import Result


@rust("ruai::pyrt::lib::ruai_plot::Text")
class Text:
    def __str__(self) -> str: ...
    def get_text(self) -> str: ...


@rust("ruai::pyrt::lib::ruai_plot::Line2D")
class Line2D:
    def __str__(self) -> str: ...
    def get_label(self) -> str: ...
    def set_label(self, s: str) -> None: ...
    def get_color(self) -> str: ...
    def get_xdata(self) -> ndarray: ...
    def get_ydata(self) -> ndarray: ...
    def get_linewidth(self) -> float: ...
    def get_linestyle(self) -> str: ...
    def get_marker(self) -> str: ...


@rust("ruai::pyrt::lib::ruai_plot::BarContainer")
class BarContainer:
    def __str__(self) -> str: ...
    def __len__(self) -> int: ...


@rust("ruai::pyrt::lib::ruai_plot::PathCollection")
class PathCollection: ...


@rust("ruai::pyrt::lib::ruai_plot::AxesImage")
class AxesImage: ...


@rust("ruai::pyrt::lib::ruai_plot::Axes")
class Axes:
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def plot(self, x: list[float] | list[int] | ndarray, y: list[float] | list[int] | ndarray, fmt: str = "", /, *,
             label: str = "", color: str = "", linewidth: float = 0.0, linestyle: str = "", marker: str = "") -> Result[list[Line2D], ValueError]: ...
    @rust("{self}.plot_y({0}, {1}, {2}, {3}, {4}, {5}, {6})")
    def plot(self, y: list[float] | list[int] | ndarray, fmt: str = "", /, *,
             label: str = "", color: str = "", linewidth: float = 0.0, linestyle: str = "", marker: str = "") -> Result[list[Line2D], ValueError]: ...
    def scatter(self, x: list[float] | list[int] | ndarray, y: list[float] | list[int] | ndarray, s: float = 36.0, *,
                color: str = "", marker: str = "", alpha: float = 1.0, label: str = "") -> Result[PathCollection, ValueError]: ...
    def bar(self, x: list[float] | list[int] | ndarray, height: list[float] | list[int] | ndarray, width: float = 0.8, *,
            color: str = "", label: str = "") -> Result[BarContainer, ValueError]: ...
    @rust("{self}.bar_cat({0}, {1}, {2}, {3}, {4})")
    def bar(self, x: list[str], height: list[float] | list[int] | ndarray, width: float = 0.8, *,
            color: str = "", label: str = "") -> Result[BarContainer, ValueError]: ...
    def hist(self, x: list[float] | list[int] | ndarray, bins: int = 10, *, color: str = "", label: str = "") -> Result[tuple[ndarray, ndarray, BarContainer], ValueError]: ...
    def imshow(self, X: ndarray, *, cmap: str = "viridis") -> Result[AxesImage, ValueError]: ...
    def text(self, x: float, y: float, s: str) -> Text: ...
    def axhline(self, y: float = 0.0, *, color: str = "", linestyle: str = "", linewidth: float = 0.0, label: str = "") -> Line2D: ...
    def axvline(self, x: float = 0.0, *, color: str = "", linestyle: str = "", linewidth: float = 0.0, label: str = "") -> Line2D: ...
    def set_title(self, label: str) -> Text: ...
    def set_xlabel(self, xlabel: str) -> Text: ...
    def set_ylabel(self, ylabel: str) -> Text: ...
    def get_title(self) -> str: ...
    def get_xlabel(self) -> str: ...
    def get_ylabel(self) -> str: ...
    def set_xlim(self, left: float, right: float) -> tuple[float, float]: ...
    def set_ylim(self, bottom: float, top: float) -> tuple[float, float]: ...
    def get_xlim(self) -> tuple[float, float]: ...
    def get_ylim(self) -> tuple[float, float]: ...
    def get_xticks(self) -> ndarray: ...
    def get_yticks(self) -> ndarray: ...
    def get_lines(self) -> list[Line2D]: ...
    def legend(self, *, loc: str = "best") -> None: ...
    def grid(self, visible: bool = True) -> None: ...


@rust("ruai::pyrt::lib::ruai_plot::Figure")
class Figure:
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def add_subplot(self, nrows: int, ncols: int, index: int) -> Result[Axes, ValueError]: ...
    @property
    def axes(self) -> list[Axes]: ...
    def suptitle(self, t: str) -> Text: ...
    def set_size_inches(self, w: float, h: float) -> None: ...
    def get_size_inches(self) -> ndarray: ...
    def tight_layout(self) -> None: ...
    def savefig(self, fname: str, *, dpi: float | None = None) -> Result[None, ValueError | OSError]: ...


def figure(*, figsize: tuple[float, float] | None = None, dpi: float = 100.0) -> Figure: ...
@rust("ruai::pyrt::lib::ruai_plot::subplots1")
def subplots(*, figsize: tuple[float, float] | None = None) -> tuple[Figure, Axes]: ...
def subplots(nrows: int, ncols: int = 1, *, figsize: tuple[float, float] | None = None) -> Result[tuple[Figure, list[Axes]], ValueError]: ...
def subplot(nrows: int, ncols: int, index: int) -> Result[Axes, ValueError]: ...
def gcf() -> Figure: ...
def gca() -> Axes: ...
def show() -> None: ...
def close() -> None: ...
@rust("ruai::pyrt::lib::ruai_plot::close_fig")
def close(fig: Figure) -> None: ...
@rust("ruai::pyrt::lib::ruai_plot::close_all")
def close(fig: str) -> Result[None, ValueError]: ...

# the current axes / figure (pyplot)
@rust("ruai::pyrt::lib::ruai_plot::gca().plot({0}, {1}, {2}, {3}, {4}, {5}, {6}, {7})")
def plot(x: list[float] | list[int] | ndarray, y: list[float] | list[int] | ndarray, fmt: str = "", /, *,
         label: str = "", color: str = "", linewidth: float = 0.0, linestyle: str = "", marker: str = "") -> Result[list[Line2D], ValueError]: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().plot_y({0}, {1}, {2}, {3}, {4}, {5}, {6})")
def plot(y: list[float] | list[int] | ndarray, fmt: str = "", /, *,
         label: str = "", color: str = "", linewidth: float = 0.0, linestyle: str = "", marker: str = "") -> Result[list[Line2D], ValueError]: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().scatter({0}, {1}, {2}, {3}, {4}, {5}, {6})")
def scatter(x: list[float] | list[int] | ndarray, y: list[float] | list[int] | ndarray, s: float = 36.0, *,
            color: str = "", marker: str = "", alpha: float = 1.0, label: str = "") -> Result[PathCollection, ValueError]: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().bar({0}, {1}, {2}, {3}, {4})")
def bar(x: list[float] | list[int] | ndarray, height: list[float] | list[int] | ndarray, width: float = 0.8, *,
        color: str = "", label: str = "") -> Result[BarContainer, ValueError]: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().bar_cat({0}, {1}, {2}, {3}, {4})")
def bar(x: list[str], height: list[float] | list[int] | ndarray, width: float = 0.8, *,
        color: str = "", label: str = "") -> Result[BarContainer, ValueError]: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().hist({0}, {1}, {2}, {3})")
def hist(x: list[float] | list[int] | ndarray, bins: int = 10, *, color: str = "", label: str = "") -> Result[tuple[ndarray, ndarray, BarContainer], ValueError]: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().imshow({0}, {1})")
def imshow(X: ndarray, *, cmap: str = "viridis") -> Result[AxesImage, ValueError]: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().text({0}, {1}, {2})")
def text(x: float, y: float, s: str) -> Text: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().axhline({0}, {1}, {2}, {3}, {4})")
def axhline(y: float = 0.0, *, color: str = "", linestyle: str = "", linewidth: float = 0.0, label: str = "") -> Line2D: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().axvline({0}, {1}, {2}, {3}, {4})")
def axvline(x: float = 0.0, *, color: str = "", linestyle: str = "", linewidth: float = 0.0, label: str = "") -> Line2D: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().set_title({0})")
def title(label: str) -> Text: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().set_xlabel({0})")
def xlabel(xlabel: str) -> Text: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().set_ylabel({0})")
def ylabel(ylabel: str) -> Text: ...
@rust("ruai::pyrt::lib::ruai_plot::xlim_get")
def xlim() -> tuple[float, float]: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().set_xlim({0}, {1})")
def xlim(left: float, right: float) -> tuple[float, float]: ...
@rust("ruai::pyrt::lib::ruai_plot::ylim_get")
def ylim() -> tuple[float, float]: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().set_ylim({0}, {1})")
def ylim(bottom: float, top: float) -> tuple[float, float]: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().legend({0})")
def legend(*, loc: str = "best") -> None: ...
@rust("ruai::pyrt::lib::ruai_plot::gca().grid({0})")
def grid(visible: bool = True) -> None: ...
@rust("ruai::pyrt::lib::ruai_plot::gcf().suptitle({0})")
def suptitle(t: str) -> Text: ...
def tight_layout() -> None: ...
@rust("ruai::pyrt::lib::ruai_plot::gcf().savefig({0}, {1})")
def savefig(fname: str, *, dpi: float | None = None) -> Result[None, ValueError | OSError]: ...
