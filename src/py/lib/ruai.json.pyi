"""py0 package `ruai.json`: a JSON value with a static type (`json.loads` is
outside the subset). `get` / `at` / `items` return copies; `str_or`,
`int_or`, ... read a scalar or give the default; `dumps` prints like CPython's
`json.dumps`. CPython stand-in: py0/python/ruai/json.py."""

from rust import Result

class Json:
    @staticmethod
    def loads(s: str) -> Result["Json"]: ...
    @staticmethod
    def null() -> "Json": ...
    @staticmethod
    def of_bool(b: bool) -> "Json": ...
    @staticmethod
    def of_int(i: int) -> "Json": ...
    @staticmethod
    def of_float(x: float) -> "Json": ...
    @staticmethod
    def of_str(s: str) -> "Json": ...
    @staticmethod
    def of_strs(xs: list[str]) -> "Json": ...
    @staticmethod
    def new_list() -> "Json": ...
    @staticmethod
    def new_dict() -> "Json": ...

    def kind(self) -> str: ...
    def is_null(self) -> bool: ...
    def truthy(self) -> bool: ...
    def str_or(self, default: str) -> str: ...
    def int_or(self, default: int) -> int: ...
    def float_or(self, default: float) -> float: ...
    def bool_or(self, default: bool) -> bool: ...
    def text(self) -> str: ...
    def get(self, key: str) -> "Json": ...
    def get_str(self, key: str, default: str) -> str: ...
    def has(self, key: str) -> bool: ...
    def keys(self) -> list[str]: ...
    def at(self, i: int) -> "Json": ...
    def items(self) -> list["Json"]: ...
    def strs(self) -> list[str]: ...
    def size(self) -> int: ...
    @mut
    def set(self, key: str, v: "Json") -> None: ...
    @mut
    def remove(self, key: str) -> None: ...
    @mut
    def append(self, v: "Json") -> None: ...
    def copy(self) -> "Json": ...
    def dumps(self, indent: int | None = None, ensure_ascii: bool = True) -> str: ...
