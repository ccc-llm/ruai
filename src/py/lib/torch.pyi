# crate: pyrt/torch
"""py0 package `torch` (`import torch`): a subset of PyTorch on ruai's nn engine
(float32 tensors with autograd). `torch.manual_seed` gives PyTorch's random
numbers and `nn.Linear` initial weights; tensors print as PyTorch's. Models
are `nn.Sequential` or plain classes holding layers (subclassing nn.Module is
not supported); `parameters()` returns a list. Dtypes are strings in py0
(`dtype=torch.float32` is "float32")."""

from numpy import ndarray
from rust import Result

float32 = "float32"
float = "float32"
int64 = "int64"
long = "int64"


@rust("ruai::pyrt::Index")
class Index: ...


