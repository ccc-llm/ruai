# crate: pyrt/numpy
"""py0 package `numpy`: a subset of NumPy (`import numpy as np`), in Rust
(`ruai::pyrt::lib::numpy`). Arrays hold float64, int64 or bool; values,
dtypes, printing and errors match NumPy 2. Under CPython the real NumPy runs.

Differences that typing brings: `a[i]` and reductions give 0-d arrays (NumPy
scalars), so write `float(a.sum())` where a Python float is needed; `a.shape`
prints like a tuple and is indexed (`a.shape[0]`) but not unpacked; dtypes are
strings (`dtype="int64"`, `a.astype("float64")`)."""

from rust import Result

pi = 3.141592653589793
e = 2.718281828459045
inf = 1e309
nan = 1e309 - 1e309


@rust("ruai::pyrt::Index")
class Index: ...


