class dtype:
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    @property
    def name(self) -> str: ...
    def __eq__(self, o: dtype) -> bool: ...


@rust("ruai::pyrt::lib::numpy::Shape")
class Shape:
    def __getitem__(self, i: int) -> Result[int, IndexError]: ...
    def __len__(self) -> int: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __eq__(self, o: Shape) -> bool: ...
    def tolist(self) -> list[int]: ...


