@rust("ruai::pyrt::lib::numpy::linalg")
class linalg:
    @staticmethod
    def inv(a: ndarray) -> Result[ndarray, ValueError]: ...
    @staticmethod
    def solve(a: ndarray, b: ndarray) -> Result[ndarray, ValueError]: ...
    @staticmethod
    def det(a: ndarray) -> Result[ndarray, ValueError]: ...
    @staticmethod
    def norm(x: ndarray) -> ndarray: ...


@rust("ruai::pyrt::lib::numpy::random::Generator")
class Generator:
    @rust("{self}.random1()")
    def random(self) -> float: ...
    def random(self, size: int | tuple[int] | tuple[int, int] | tuple[int, int, int] | list[int]) -> Result[ndarray, ValueError]: ...
    @rust("{self}.uniform1({0}, {1})")
    def uniform(self, low: float = 0.0, high: float = 1.0) -> float: ...
    def uniform(self, low: float, high: float, size: int | tuple[int] | tuple[int, int] | tuple[int, int, int] | list[int]) -> Result[ndarray, ValueError]: ...
    @rust("{self}.integers1(0, {0})")
    def integers(self, high: int) -> Result[int, ValueError]: ...
    @rust("{self}.integers1({0}, {1})")
    def integers(self, low: int, high: int) -> Result[int, ValueError]: ...
    def integers(self, low: int, high: int, size: int | tuple[int] | tuple[int, int] | tuple[int, int, int] | list[int]) -> Result[ndarray, ValueError]: ...
    def shuffle(self, x: ndarray) -> Result[None, TypeError]: ...
    def permutation(self, n: int) -> Result[ndarray, TypeError | ZeroDivisionError]: ...
    @rust("{self}.permuted_copy({0})")
    def permutation(self, x: ndarray) -> Result[ndarray, TypeError]: ...


