# crate: pyrt/gymnasium
"""py0 package `gymnasium` (`import gymnasium as gym`): the environments of
ruai's `world` (CartPole-v1, MountainCar-v0, Pendulum-v1, Acrobot-v1,
FrozenLake-v1, FrozenLake8x8-v1), bit for bit as Gymnasium, with its API.
Observations are numpy arrays (float32 for Box spaces, a 0-d int for Discrete
ones), rewards floats, infos `dict[str, float]`."""

from numpy import ndarray
from numpy import Shape
from rust import Result


@rust("ruai::pyrt::lib::gymnasium::Space")
class Space:
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    @property
    def n(self) -> Result[ndarray, AttributeError]: ...
    @property
    def shape(self) -> Shape: ...
    @property
    def low(self) -> Result[ndarray, AttributeError | ValueError]: ...
    @property
    def high(self) -> Result[ndarray, AttributeError | ValueError]: ...
    def seed(self, seed: int) -> int: ...
    def sample(self) -> Result[ndarray, ValueError]: ...
    def contains(self, x: int | ndarray) -> Result[bool, TypeError | ValueError]: ...


@rust("ruai::pyrt::lib::gymnasium::Env")
class Env:
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def reset(self, seed: int | None = None) -> Result[tuple[ndarray, dict[str, float]], ValueError]: ...
    def step(self, action: int | ndarray) -> Result[tuple[ndarray, float, bool, bool, dict[str, float]], AssertionError | TypeError | ValueError]: ...
    def render(self) -> Result[str, ValueError]: ...
    def close(self) -> None: ...
    @property
    def action_space(self) -> Space: ...
    @property
    def observation_space(self) -> Space: ...


def make(id: str, render_mode: str | None = None) -> Result[Env, Exception]: ...
