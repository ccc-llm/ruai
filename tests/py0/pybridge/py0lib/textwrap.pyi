# python: textwrap
"""textwrap, through CPython (a test of the Python bridge)."""

def wrap(text: str, width: int = ...) -> list[str]: ...
def fill(text: str, width: int = ..., *, initial_indent: str = ...) -> str: ...
def dedent(text: str) -> str: ...
def shorten(text: str, width: int, *, placeholder: str = ...) -> str: ...
