# python: datetime
"""datetime.date, through CPython."""

class date:
    def __init__(self, year: int, month: int, day: int) -> None: ...
    def isoformat(self) -> str: ...
    def weekday(self) -> int: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    @property
    def year(self) -> int: ...
    @staticmethod
    def fromisoformat(date_string: str) -> date: ...
